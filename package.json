{
  "name": "markab",
  "description": "A fast Markdown notebook that lives in your new tab, with optional Obsidian vault sync.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@lezer/common": "^1.5.7",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.2",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-collaboration": "^3.35.0",
    "@tiptap/extension-drag-handle": "^3.35.0",
    "@tiptap/extension-drag-handle-react": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-node-range": "^3.35.0",
    "@tiptap/extension-typography": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/y-tiptap": "^3.3.1",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=20"
  }
